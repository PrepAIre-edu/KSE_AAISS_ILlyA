# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Claude Agent SDK (the study-planner agent). OPTIONAL: leave unset (or
# delete this line) to use whatever claude.ai account is already logged into
# Claude Code on this machine (Pro/Max subscription, no separate API billing).
# Set a real sk-ant-... key here only if you want to bill this run to a
# pay-per-token Anthropic Console API account instead.
# ANTHROPIC_API_KEY=sk-ant-...

# Obsidian Local REST API plugin (Settings -> Local REST API in Obsidian, after
# installing the community plugin into a DEDICATED demo vault).
# Using the insecure http:// port here on purpose: it's loopback-only
# (127.0.0.1, never leaves the machine) and avoids self-signed-cert trust
# friction for the Node-based Claude Code CLI, which has no simple way to
# trust the plugin's self-signed HTTPS certificate. The plugin's own default
# (https://127.0.0.1:27124) would need real certificate handling, not
# implemented here — see docs/DESIGN_RATIONALE.md.
OBSIDIAN_API_KEY=paste-the-key-shown-in-plugin-settings
OBSIDIAN_BASE_URL=http://127.0.0.1:27123

# --- optional, both have working defaults ---

# Overrides where curriculum-mcp looks for concept_graph.json (course_metadata.json's
# path is fixed, next to mcp_servers/curriculum_mcp/server.py). Default: output/dataset.
# CURRICULUM_DATA_DIR=./output/dataset

# Overrides the model the study-planner agent runs as. Default: claude-sonnet-5.
# STUDY_PLANNER_MODEL=claude-sonnet-5
